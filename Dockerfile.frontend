# Etapa de construcción
FROM node:18-alpine AS builder

WORKDIR /app

# Copiar archivos del frontend
COPY frontend/ .

# Instalar dependencias si hay package.json
RUN if [ -f package.json ]; then npm install; fi

# ─────────────────────────────────────────────────────────────────────────────
# Etapa final — Nginx para servir archivos estáticos
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:alpine

# Instalar utilidad para reemplazar variables (sed ya está incluido en alpine)
# No se requieren instalaciones adicionales

# Copiar configuración de Nginx
COPY nginx.conf /etc/nginx/nginx.conf

# Copiar archivos estáticos del frontend
COPY --from=builder /app /usr/share/nginx/html

# Copiar el script de entrypoint (inyecta BACKEND_URL en env-config.js al arrancar)
COPY scripts/docker-entrypoint.sh /docker-entrypoint-custom.sh
RUN chmod +x /docker-entrypoint-custom.sh

# Argumentos de build para trazabilidad
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

# Labels OCI estándar
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="ArepIA Frontend" \
      org.opencontainers.image.description="Frontend HTML/JS para sistema de gestión de arepas"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

# Variable de entorno con valor por defecto (se sobreescribe en Render)
ENV BACKEND_URL=http://localhost:8000

# Exponer puerto
EXPOSE 80

# Entrypoint: inyecta BACKEND_URL → luego arranca Nginx
ENTRYPOINT ["/docker-entrypoint-custom.sh"]
CMD ["nginx", "-g", "daemon off;"]
